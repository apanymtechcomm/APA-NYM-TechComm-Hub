# PUBLIC client config baked into the static export.
#
# These values are PUBLIC by design — they are compiled into the shipped HTML
# and visible to anyone. No secrets belong in this file; the Turnstile SECRET
# lives only in the Worker (`wrangler secret put TURNSTILE_SECRET`).
#
# WHY THIS FILE EXISTS: `next build` inlines NEXT_PUBLIC_* at build time. When
# a republish runs without these exports, `EventRsvpForm`/`SignupForm` render
# the "being configured" placeholder and both the RSVP page and the contact
# signup form go silently dead on the live site. That is exactly what happened
# on the 2026-10-18 republish round. `scripts/build-static.sh` sources this
# file so every build carries them, regardless of the caller's shell.

# Cloudflare Worker endpoint for event RSVPs (D1 table `event_rsvps`).
NEXT_PUBLIC_EVENT_RSVP_API_URL=https://signup.abucks.world/v1/event-rsvps

# Cloudflare Worker endpoint for the newsletter/committee signup form.
NEXT_PUBLIC_SIGNUP_API_URL=https://signup.abucks.world/v1/signup

# Public Turnstile sitekey (widget `apanymtechcomm-signup-v2`).
# Retrieve with: pnpm exec wrangler turnstile widget list
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFYwLlgRW3Q8OeF-
